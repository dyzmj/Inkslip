{
  "name": "inkslip",
  "version": "0.8.2",
  "private": true,
  "description": "A desktop Markdown editor for focused writing",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/package.mjs",
    "package:win": "npm run package -- --platform=win32 --arch=x64",
    "package:mac": "npm run package -- --platform=darwin"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "dictionary-en": "4.0.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "iconv-lite": "0.6.3",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "12.1.0",
    "nspell": "2.1.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "playwright-core": "1.64.0",
    "vite": "8.3.4"
  },
  "productName": "Inkslip",
  "author": "dyzmj",
  "repository": {
    "type": "git",
    "url": "https://github.com/dyzmj/Inkslip.git"
  },
  "engines": {
    "node": ">=24"
  }
}
